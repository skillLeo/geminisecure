<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run against MySQL, not SQLite.

            The schema uses MySQL triggers for the append-only ledger, and the
            isolation model rests on real GRANT behaviour. A SQLite suite would
            be green while exercising something this application never runs.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="gs_platform_test"/>
        <env name="DB_PORT" value="3307"/>
        <env name="DB_URL" value=""/>

        <!--
            The suite connects as gs_owner because RefreshDatabase builds and
            drops the schema on every run, which gs_app cannot and must not do.

            This does NOT weaken the isolation guarantee. The restriction on
            gs_app is exactly what `php artisan gate:isolation` proves, against
            the real databases and real grants, which is the only place it can
            be proved honestly.
        -->
        <env name="DB_USERNAME" value="gs_owner"/>
        <env name="DB_PASSWORD" value="change_me_owner"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
